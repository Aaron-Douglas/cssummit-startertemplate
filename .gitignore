# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: real values live in .env.local (never committed); .env.example lists names only
.env*
!.env.example

# vercel
.vercel

# cloudflare (OpenNext build output, wrangler state, local secrets for wrangler dev)
/.open-next/
/.wrangler/
.dev.vars*
cloudflare-env.d.ts

# claude code: personal, machine-specific settings and notes
.claude/settings.local.json
CLAUDE.local.md

# stray logs
*.log

# typescript
*.tsbuildinfo
next-env.d.ts
