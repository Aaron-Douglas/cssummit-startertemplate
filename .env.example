# Environment variables for this project.
#
# Copy this file to .env.local and fill in values there. .env.local is git-ignored.
# Never put real keys or passwords in this file: it is committed.
# The core template needs none of these. Kits add their own variables below
# when you run `pnpm kit add <name>`. Code reads them through lib/env.ts.

# Show the live design switcher panel outside `pnpm dev` (for example on your deployed demo).
# Set to true to turn it on.
NEXT_PUBLIC_DESIGN_SWITCHER=

# Optional. Your site's public URL (for share-card metadata), e.g. https://your-project.vercel.app
# Empty = Vercel's URL when deployed there, http://localhost:3000 otherwise.
NEXT_PUBLIC_SITE_URL=
